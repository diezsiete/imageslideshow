{# basedon src/PrestaShopBundle/Resources/views/Admin/TwigTemplateForm/bootstrap_4_layout.html.twig:file_widget #}
{%- block file_upload_widget -%}
  <div class="custom-file">
    {% if attr.disabled is defined and attr.disabled %}
      {% set attr = attr|merge({
        class: attr.class ~ ' disabled'
      }) %}
    {% endif %}

    {{- block('form_widget_simple') -}}
    {#<input type="file" class="dropzoned custom-file-input d-none" data-locale="es">#}

    <label class="custom-file-label" for="{{ form.vars.id }}" data-after-content="{{ "Browse"|trans({}, 'Admin.Actions')  }}">
      {% set attributes = form.vars.attr %}
      {{ attributes.placeholder is defined ?  attributes.placeholder : 'Choose file(s)'|trans({}, 'Admin.Actions') }}
    </label>
  </div>
{%- endblock -%}


{#{%- block slide_edtor_image_row -%}#}
{#  {{- block('form_row') -}}#}
{#{%- endblock -%}#}

{%- block slide_edtor_image_widget -%}
  {%- set type = 'hidden' -%}
  {%- set dzdTrigger = id ~ '_dzd_trigger' -%}

  <button class="btn btn-primary d-none" id="{{ dzdTrigger }}" data-dzd-url="{{ dzd.url }}" data-dzd-fetch-url="{{ dzd.fetchUrl }}">
  </button>

  <div class="slide-editor" data-dzd-trigger="#{{ dzdTrigger }}">
    <div class="slide-editor-toolbar"></div>
    <div class="imageslideshow imageless admin">
      <div class="resizable-element">
        <div class="slide-content"></div>
      </div>
      <div class="loader-overlay"><div class="spinner"></div></div>
    </div>
  </div>

  {{- block('form_widget_simple') -}}
{%- endblock -%}
