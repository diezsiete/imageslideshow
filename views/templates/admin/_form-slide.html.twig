{# **
 * basedon src/PrestaShopBundle/Resources/views/Admin/Improve/Design/Cms/Blocks/form.html.twig
 *         src/PrestaShopBundle/Resources/views/Admin/Sell/Catalog/Manufacturer/Blocks/form.html.twig
 * #}

{% form_theme form with [
  '@PrestaShop/Admin/TwigTemplateForm/prestashop_ui_kit.html.twig',
  '@Modules/imageslideshow/views/templates/admin/_form-widgets.html.twig'
] %}
{% import '@PrestaShop/Admin/macros.html.twig' as ps %}
{% from '@Modules/imageslideshow/views/templates/admin/_macros.html.twig' import form_image_row %}

<button class="btn btn-primary d-none" id="slide-editor-dzd-trigger" data-dzd-url="{{ form.vars.dzdUrl }}" data-dzd-fetch-url="{{ form.vars.dzdFetchUrl }}">
</button>

{{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
<div class="card">
  <div class="card-header">
    {# TODO translate spanish : Diapositiva #}
    {{ 'Slide'|trans({}, 'Modules.Imageslideshow.Imageslideshow') }}
  </div>
  <div class="card-body">

    <div class="container-lg">
      {{ form_errors(form) }}
      <div class="slide-editor">
        <div class="slide-editor-toolbar"></div>
        <div class="imageslideshow imageless">
          <div class="resizable-element">
            <div class="slide-content"></div>
          </div>
          <div class="loader-overlay"><div class="spinner"></div></div>
        </div>
      </div>
    </div>

    <div class="form-wrapper">

      {{ form_row(form.image) }}

      {#{{ form_image_row(form.image, image, form.image.vars, form.image.vars.extra) }}#}

      {{ form_image_row(form.imageMobile, null, form.imageMobile.vars, form.imageMobile.vars.extra) }}

      {{ form_row(form.title) }}

      {{ form_row(form.url) }}

      {{ form_row(form.legend) }}

      {# TODO translate spanish : Descripción #}
      {#{{ ps.form_group_row(form.description, form.description.vars, {
        'label': 'Description'|trans({}, 'Modules.Imageslideshow.Imageslideshow'),
        'class': 'she-tinymce'
      }) }}#}
      {{ form_row(form.description) }}

      {{ form_row(form.targetBlank) }}

      {{ form_row(form.active) }}

      {{ form_rest(form) }}
    </div>
  </div>

  <div class="card-footer">
    <a href="{{ path('imageslideshow_slides', { idImageSlideshow: idImageSlideshow }) }}" class="btn btn-outline-secondary">
      {{ 'Cancel'|trans({}, 'Admin.Actions') }}
    </a>
    <button class="btn btn-primary float-right">
      {{ 'Save'|trans({}, 'Admin.Actions') }}
    </button>
  </div>
</div>
{{ form_end(form) }}
