{% form_theme form '@PrestaShop/Admin/TwigTemplateForm/prestashop_ui_kit.html.twig' %}
{% import '@PrestaShop/Admin/macros.html.twig' as ps %}

{{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
<div class="card">
  <div class="card-header">
    {# TODO translate spanish : Carrusel #}
    {{ 'Slideshow'|trans({}, 'Modules.Imageslideshow.Imageslideshow') }}
  </div>
  <div class="card-body">
    <div class="form-wrapper">
      {{ form_errors(form) }}

      {{ form_row(form.name) }}

      {{ form_row(form.slug) }}

      {{ form_row(form.active) }}

      {{ form_rest(form) }}
    </div>
  </div>

  <div class="card-footer">
    <a href="{{ path('imageslideshow_index') }}" class="btn btn-outline-secondary">
      {{ 'Cancel'|trans({}, 'Admin.Actions') }}
    </a>
    <button class="btn btn-primary float-right">
      {{ 'Save'|trans({}, 'Admin.Actions') }}
    </button>
  </div>
</div>
{{ form_end(form) }}
